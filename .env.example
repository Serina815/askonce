NODE_ENV=production
PORT=3000
HOST=127.0.0.1
APP_URL=http://你的公网IP

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=askonce
DB_PASS=在此填强密码
DB_NAME=askonce

# openssl rand -hex 32
SESSION_SECRET=在此填 64 位随机十六进制字符串

# 单张截图上限（字节）
UPLOAD_MAX_BYTES=8388608

# ---------- AI（OpenAI 兼容接口，留空则关闭 AI 功能）----------
# DeepSeek:  AI_BASE_URL=https://api.deepseek.com   AI_MODEL=deepseek-chat
# 通义千问:   AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   AI_MODEL=qwen-plus
# OpenAI:    AI_BASE_URL=https://api.openai.com/v1   AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=30000

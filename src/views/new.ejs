<%- include('partials/head') %>

<section class="form-page">
  <h1>记一个问题</h1>

  <form class="stack-form" action="/problems?_csrf=<%= csrfToken %>" method="post" enctype="multipart/form-data"
        data-busy data-paste-file>
    <div class="field">
      <label for="title">一句话问题 *</label>
      <input id="title" type="text" name="title" required maxlength="200" autofocus placeholder="Docker 构建时 npm ci 报 EACCES">
    </div>

    <div class="field">
      <label for="error_text">报错原文</label>
      <textarea id="error_text" name="error_text" rows="6" placeholder="粘贴报错原文"></textarea>
    </div>

    <div class="row">
      <div class="field">
        <label for="context">场景 / 环境</label>
        <input id="context" type="text" name="context" maxlength="500" placeholder="CentOS 9 · Node 22">
      </div>
      <div class="field">
        <label for="tags">标签</label>
        <input id="tags" type="text" name="tags" maxlength="255" placeholder="nginx,权限">
      </div>
    </div>

    <div class="field">
      <label for="shot">截图</label>
      <input id="shot" type="file" name="shot" accept="image/*">
      <div class="shot-preview" data-file-preview></div>
    </div>

    <div class="form-actions">
      <button class="btn" type="submit">保存</button>
      <a class="btn ghost" href="/">取消</a>
    </div>
  </form>
</section>

<%- include('partials/foot') %>

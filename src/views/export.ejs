<%- include('partials/head') %>

<section class="hero small">
  <p class="kicker">导出</p>
  <h1>数据在你手里</h1>
  <p class="stat-strip">共 <%= total %> 张卡 · 待整理 <%= counts.draft %> · 待复盘 <%= counts.solved %> · 已掌握 <%= counts.mastered %></p>
</section>

<section class="panel">
  <h2>导出</h2>
  <div class="export-grid">
    <a class="export-card" href="/export.md">
      <strong>Markdown</strong>
    </a>
    <a class="export-card" href="/export.csv">
      <strong>Anki CSV</strong>
    </a>
    <a class="export-card" href="/export.json">
      <strong>JSON</strong>
    </a>
  </div>
</section>

<section class="panel">
  <h2>AI</h2>
  <p>
    <%= aiEnabled ? '已启用' : '未配置' %>
    <% if (aiEnabled) { %>· 模型 <code><%= aiModel %></code><% } %>
  </p>
</section>

<section class="panel">
  <h2>运行环境</h2>
  <p class="hint">Node <%= nodeVersion %></p>
</section>

<%- include('partials/foot') %>

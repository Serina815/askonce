<%- include('partials/head') %>

<%
  const STATUS = {
    draft: { text: '待整理', cls: 'draft' },
    solved: { text: '待复盘', cls: 'solved' },
    mastered: { text: '已掌握', cls: 'mastered' },
    archived: { text: '已归档', cls: 'archived' },
  };
%>

<section class="hero">
  <div class="hero-main">
    <p class="kicker">全部</p>
    <h1><%= dueCount %> 张该复盘</h1>
  </div>
  <div class="hero-actions">
    <% if (dueCount) { %>
      <a class="btn big" href="/review">开始复盘 →</a>
    <% } else { %>
      <button type="button" class="btn big" data-open-capture>记一个问题</button>
    <% } %>
  </div>
</section>

<section class="panel">
  <div class="panel-head">
    <h2>全部卡片 <span class="count"><%= cards.length %></span></h2>
    <span class="panel-links">
      <a class="linkbtn" href="/drafts">只看待整理</a>
      <a class="linkbtn" href="/search">搜索 →</a>
    </span>
  </div>

  <% if (!cards.length) { %>
    <div class="empty-state">
      <p class="empty">还没有卡片。</p>
      <button type="button" class="btn" data-open-capture>记第一个问题</button>
    </div>
  <% } else { %>
    <ul class="cards">
      <% cards.forEach(function (p) { const s = STATUS[p.status] || STATUS.draft; %>
        <li class="card is-<%= p.status %>">
          <a class="card-main" href="/p/<%= p.id %>">
            <span class="card-title"><%= p.title %></span>
            <span class="card-meta">
              <span class="chip <%= s.cls %>"><%= s.text %></span>
              <% if (p.recurrence_count > 0) { %><span class="chip recur">复发 <%= p.recurrence_count %></span><% } %>
              <% if (p.tags) { %><span class="card-tags"><%= p.tags.split(',').join(' · ') %></span><% } %>
            </span>
          </a>
          <span class="card-side">
            <% if (p.status === 'draft') { %><a class="card-cta" href="/p/<%= p.id %>/edit">补三问 →</a><% } %>
            <span class="dots" title="掌握度"><i class="<%= p.mastery >= 1 ? 'on' : '' %>"></i><i class="<%= p.mastery >= 2 ? 'on' : '' %>"></i><i class="<%= p.mastery >= 3 ? 'on' : '' %>"></i></span>
            <% if (p.next_review_on) { %><span class="card-date"><%= p.next_review_on %></span><% } %>
          </span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<%- include('partials/foot') %>

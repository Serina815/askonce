<%- include('partials/head') %>

<section class="hero small">
  <p class="kicker">待整理</p>
  <h1><%= drafts.length %> 张等着补三问</h1>
</section>

<% if (!drafts.length) { %>
  <section class="empty-page">
    <p class="empty">没有待整理的卡。</p>
    <p><a class="btn" href="/">回全部</a></p>
  </section>
<% } else { %>
  <ul class="cards">
    <% drafts.forEach(function (p) { %>
      <li class="card is-draft card-draft">
        <a class="card-main" href="/p/<%= p.id %>">
          <span class="card-title"><%= p.title %></span>
          <span class="card-meta">
            <% if (p.tags) { %><span class="card-tags"><%= p.tags.split(',').join(' · ') %></span><% } %>
            <span class="card-date">记于 <%= String(p.created_at).slice(0, 10) %></span>
          </span>
          <% if (p.error_text) { %>
            <span class="card-excerpt"><%= String(p.error_text).split('\n')[0].slice(0, 100) %></span>
          <% } %>
        </a>
        <span class="card-side">
          <a class="btn ghost" href="/p/<%= p.id %>/edit">补三问</a>
        </span>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('partials/foot') %>

<%- include('partials/head') %>

<%
  const STATUS = {
    draft: { text: '待整理', cls: 'draft' },
    solved: { text: '待复盘', cls: 'solved' },
    mastered: { text: '已掌握', cls: 'mastered' },
    archived: { text: '已归档', cls: 'archived' },
  };
  const SOURCE = { ai: 'AI', doc: '文档', self: '自己', other: '其他' };
  const RESULT = { effective: '有效', partial: '部分有效', failed: '无效', unknown: '未验证' };
  const s = STATUS[problem.status] || STATUS.draft;
  const tags = String(problem.tags || '').split(',').filter(Boolean);
  const todayStr = typeof today !== 'undefined' ? String(today) : '';
  const hasSolution = Boolean(String(problem.final_solution || problem.q_how || '').trim());
  const isDue = Boolean(problem.next_review_on) && String(problem.next_review_on).slice(0, 10) <= todayStr;
%>

<% if (duplicates && duplicates.length) { %>
<section class="dup">
  <p class="dup-kicker">可能重复</p>
  <p class="dup-lead">这张卡看起来像你以前记过的问题。如果是同一个坑，合并过去就行。</p>
  <ul class="dup-list">
    <% duplicates.forEach(function (d) { %>
      <li class="dup-item">
        <a class="dup-link" href="/p/<%= d.id %>"><%= d.title %></a>
        <span class="dup-meta"><%= d.reason %> · 记于 <%= String(d.created_at).slice(0, 10) %></span>
        <form action="/p/<%= problem.id %>/merge/<%= d.id %>?_csrf=<%= csrfToken %>" method="post" data-confirm="合并到这张卡？新卡会被删除，截图搬过来，旧卡复发 +1、掌握度 -1、复盘提前到今天。">
          <button class="btn ghost" type="submit">是同一个，合并</button>
        </form>
      </li>
    <% }) %>
  </ul>
  <p class="hint">不是同一个问题？忽略这条提示就行，它只出现这一次。</p>
</section>
<% } %>

<article class="problem">
  <header class="problem-head">
    <div class="problem-title">
      <div class="problem-chips">
        <span class="chip <%= s.cls %>"><%= s.text %></span>
        <% if (problem.recurrence_count > 0) { %>
          <span class="chip recur">复发 <%= problem.recurrence_count %> 次</span>
        <% } %>
        <span class="dots" title="掌握度"><i class="<%= problem.mastery >= 1 ? 'on' : '' %>"></i><i class="<%= problem.mastery >= 2 ? 'on' : '' %>"></i><i class="<%= problem.mastery >= 3 ? 'on' : '' %>"></i></span>
      </div>
      <h1><%= problem.title %></h1>
      <p class="problem-meta">
        <% tags.forEach(function (t) { %>
          <a class="tag" href="/search?q=<%= encodeURIComponent(t) %>">#<%= t %></a>
        <% }) %>
        <span class="muted">记录于 <%= String(problem.created_at).slice(0, 10) %></span>
        <% if (problem.next_review_on) { %><span class="muted">· 下次复盘 <%= problem.next_review_on %></span><% } %>
      </p>
    </div>

    <div class="problem-actions">
      <form action="/p/<%= problem.id %>/ai-reference?_csrf=<%= csrfToken %>" method="post" data-busy>
        <button class="btn ghost" type="submit" <%= aiEnabled ? '' : 'disabled title="未配置 AI_API_KEY"' %>><%= (problem.ai_what || problem.ai_why || problem.ai_how) ? '重新生成参考' : '生成 AI 参考' %></button>
      </form>
      <a class="btn ghost" href="/p/<%= problem.id %>/edit">编辑</a>
      <form action="/p/<%= problem.id %>/delete?_csrf=<%= csrfToken %>" method="post" data-confirm="删除这张卡？尝试记录和截图会一起删除。">
        <button class="linkbtn danger" type="submit">删除</button>
      </form>
    </div>
  </header>

  <% if (problem.status === 'archived') { %>
    <section class="next-step next-quiet">
      <p class="next-kicker">状态</p>
      <div class="next-main">
        <p class="next-title">已归档</p>
        <p class="next-hint">这张卡不再进入复盘队列。想重新用，编辑后标记已解决即可。</p>
      </div>
    </section>
  <% } else if (problem.status === 'draft' && !hasSolution) { %>
    <section class="next-step">
      <p class="next-kicker">下一步</p>
      <div class="next-main">
        <p class="next-title">还差一步：把三问补上</p>
        <p class="next-hint">是什么 / 怎么解 / 为什么。AI 可以给草稿，但最后要用自己的话改一遍。</p>
      </div>
      <a class="btn" href="/p/<%= problem.id %>/edit">去补三问</a>
    </section>
  <% } else if (problem.status === 'draft') { %>
    <section class="next-step">
      <p class="next-kicker">下一步</p>
      <div class="next-main">
        <p class="next-title">方案有了，可以标记解决</p>
        <p class="next-hint">标记后进入复盘队列，明天第一次复盘——解决不是终点。</p>
      </div>
      <form action="/p/<%= problem.id %>/solve?_csrf=<%= csrfToken %>" method="post" data-busy>
        <button class="btn" type="submit">标记已解决</button>
      </form>
    </section>
  <% } else if (isDue) { %>
    <section class="next-step">
      <p class="next-kicker">下一步</p>
      <div class="next-main">
        <p class="next-title">今天该复盘这张</p>
        <p class="next-hint">先别翻答案，自己想 30 秒，再点「看答案」自评。</p>
      </div>
      <a class="btn" href="/review">去复盘</a>
    </section>
  <% } else { %>
    <section class="next-step next-quiet">
      <p class="next-kicker">状态</p>
      <div class="next-main">
        <p class="next-title"><%= problem.status === 'mastered' ? '已掌握' : '等待下次复盘' %></p>
        <p class="next-hint">下次复盘：<%= problem.next_review_on || '—' %></p>
      </div>
      <form action="/p/<%= problem.id %>/recur?_csrf=<%= csrfToken %>" method="post" data-confirm="记一次复发？掌握度会 -1，下次复盘提到今天。" data-busy>
        <button class="btn ghost" type="submit">又遇到了</button>
      </form>
    </section>
  <% } %>

  <% if (problem.error_text) { %>
    <section class="block">
      <div class="block-head">
        <h2>报错原文</h2>
        <button type="button" class="linkbtn" data-copy="error-text">复制</button>
      </div>
      <pre class="code" id="error-text"><%= problem.error_text %></pre>
      <%- include('partials/shots', { shots: fieldShots.error_text, field: 'error_text', problemId: problem.id }) %>
    </section>
  <% } %>

  <% if (problem.context) { %>
    <section class="block">
      <h2>场景</h2>
      <p class="prose"><%= problem.context %></p>
      <%- include('partials/shots', { shots: fieldShots.context, field: 'context', problemId: problem.id }) %>
    </section>
  <% } %>

  <section class="block">
    <div class="block-head">
      <h2>三问</h2>
      <a class="linkbtn" href="/p/<%= problem.id %>/edit">修改</a>
    </div>

    <% if (!problem.q_what && !problem.q_how && !problem.q_why && !problem.q_plain) { %>
      <p class="empty">
        还没写。可以自己用三句话想清楚，也可以点上面的「生成 AI 参考」拿一份对照——
        但最后一定要改写成你自己的话。
      </p>
    <% } else { %>
      <div class="qa">
        <div class="qa-item">
          <h3>是什么</h3>
          <p><%= problem.q_what || '—' %></p>
          <%- include('partials/shots', { shots: fieldShots.q_what, field: 'q_what', problemId: problem.id }) %>
        </div>
        <div class="qa-item">
          <h3>为什么</h3>
          <p class="pre-wrap"><%= problem.q_why || '—' %></p>
          <%- include('partials/shots', { shots: fieldShots.q_why, field: 'q_why', problemId: problem.id }) %>
        </div>
        <div class="qa-item">
          <h3>怎么做</h3>
          <p class="pre-wrap"><%= problem.q_how || '—' %></p>
          <%- include('partials/shots', { shots: fieldShots.q_how, field: 'q_how', problemId: problem.id }) %>
        </div>
        <div class="qa-item qa-plain">
          <h3>人话版</h3>
          <p><%= problem.q_plain || '—' %></p>
          <%- include('partials/shots', { shots: fieldShots.q_plain, field: 'q_plain', problemId: problem.id }) %>
        </div>
      </div>
    <% } %>
  </section>

  <% if (problem.ai_what || problem.ai_why || problem.ai_how) { %>
    <details class="block ai-ref-block">
      <summary>
        <span class="ai-badge">AI</span>
        参考答案（不是你的答案，点开对照）
        <span class="ai-meta"><%= problem.ai_model || 'AI' %></span>
      </summary>
      <div class="ai-ref">
        <div class="ai-block">
          <h3>是什么</h3>
          <p class="pre-wrap"><%= problem.ai_what || '（没生成）' %></p>
        </div>
        <div class="ai-block">
          <h3>为什么</h3>
          <p class="pre-wrap"><%= problem.ai_why || '（没生成）' %></p>
        </div>
        <div class="ai-block">
          <h3>怎么做</h3>
          <p class="pre-wrap"><%= problem.ai_how || '（没生成）' %></p>
        </div>
        <div class="ai-ref-actions">
          <form action="/p/<%= problem.id %>/ai-apply?_csrf=<%= csrfToken %>" method="post" data-busy>
            <button class="btn ghost" type="submit">用参考填上空的字段</button>
          </form>
          <a class="linkbtn" href="/p/<%= problem.id %>/edit">去编辑页管理参考</a>
        </div>
      </div>
    </details>
  <% } %>

  <% if (problem.final_solution) { %>
    <section class="block block-key">
      <div class="block-head">
        <h2>最终方案</h2>
        <button type="button" class="linkbtn" data-copy="final-solution">复制</button>
      </div>
      <pre class="code" id="final-solution"><%= problem.final_solution %></pre>
      <p class="hint">
        解决方式：<%= problem.source === 'self' ? '自己想的' : problem.source === 'ai' ? 'AI 给的' : problem.source === 'doc' ? '查文档' : problem.source === 'mixed' ? '混合' : '未标注' %>
      </p>
      <%- include('partials/shots', { shots: fieldShots.final_solution, field: 'final_solution', problemId: problem.id }) %>
    </section>
  <% } %>

  <section class="block" id="attempts">
    <div class="block-head">
      <h2>尝试记录 <span class="count"><%= attempts.length %></span></h2>
    </div>

    <% if (!attempts.length) { %>
      <p class="empty">还没有尝试。把 AI 给的方案、文档里找到的做法都记下来，包括没用的那些。</p>
    <% } %>

    <ol class="timeline">
      <% attempts.forEach(function (a) { %>
        <li class="attempt result-<%= a.result %>">
          <div class="attempt-head">
            <span class="chip"><%= SOURCE[a.source] || a.source %><%= a.tool ? ' · ' + a.tool : '' %></span>
            <span class="chip result"><%= RESULT[a.result] || a.result %></span>
            <span class="muted"><%= String(a.created_at).slice(0, 10) %></span>
            <form action="/attempts/<%= a.id %>/delete?_csrf=<%= csrfToken %>" method="post" data-confirm="删除这条尝试？">
              <button class="linkbtn danger" type="submit">删</button>
            </form>
          </div>
          <pre class="solution"><%= a.solution %></pre>
          <% if (attemptShots[a.id] && attemptShots[a.id].length) { %>
            <div class="attempt-shots">
              <% attemptShots[a.id].forEach(function (shot) { %>
                <a href="<%= shot.path %>" target="_blank" rel="noopener">
                  <img src="<%= shot.path %>" alt="这条尝试的截图" loading="lazy">
                </a>
              <% }) %>
            </div>
          <% } %>
        </li>
      <% }) %>
    </ol>

    <details class="add-attempt">
      <summary>＋ 加一条尝试</summary>
      <form action="/p/<%= problem.id %>/attempts?_csrf=<%= csrfToken %>" method="post"
            data-busy
            data-paste-upload="/p/<%= problem.id %>/artifacts/upload"
            data-artifact-base="/p/<%= problem.id %>/artifacts">
        <input type="hidden" name="artifact_ids" value="">
        <div class="row">
          <select name="source" aria-label="来源">
            <option value="ai">AI 给的</option>
            <option value="doc">文档 / 搜索</option>
            <option value="self">我自己想的</option>
            <option value="other">其他</option>
          </select>
          <input type="text" name="tool" placeholder="工具：ChatGPT / Claude / 官方文档" maxlength="64">
          <select name="result" aria-label="结果">
            <option value="effective">有效</option>
            <option value="partial">部分有效</option>
            <option value="failed">无效</option>
            <option value="unknown">未验证</option>
          </select>
        </div>
        <textarea name="solution" rows="4" required placeholder="把方案贴进来。无效的方案也要记——它会告诉你 AI 在哪儿不靠谱。"></textarea>
        <p class="hint">Ctrl+V 可粘贴截图，会跟着这条尝试保存</p>
        <div class="form-foot">
          <button class="btn" type="submit">保存尝试</button>
          <span class="hint">截图会跟着这条尝试一起保存</span>
        </div>
      </form>
    </details>
  </section>

  <section class="block">
    <div class="block-head">
      <h2>截图与链接 <span class="count"><%= artifacts.length %></span></h2>
    </div>

    <% if (artifacts.length) { %>
      <div class="shots">
        <% artifacts.forEach(function (a) { %>
          <% if (a.kind === 'image') { %>
            <a class="shot" href="<%= a.path %>" target="_blank" rel="noopener">
              <img src="<%= a.path %>" alt="<%= a.note || '截图' %>" loading="lazy">
            </a>
          <% } else { %>
            <a class="link-item" href="<%= a.url %>" target="_blank" rel="noopener noreferrer">
              <span class="link-url"><%= a.url %></span>
              <% if (a.note) { %><span class="muted"><%= a.note %></span><% } %>
            </a>
          <% } %>
        <% }) %>
      </div>
    <% } %>

    <details class="add-attempt">
      <summary>＋ 加一个链接</summary>
      <form action="/p/<%= problem.id %>/artifacts?_csrf=<%= csrfToken %>" method="post">
        <div class="row">
          <input type="url" name="url" placeholder="https://…" required maxlength="1000">
          <input type="text" name="note" placeholder="备注（可空）" maxlength="255">
        </div>
        <button class="btn" type="submit">添加</button>
      </form>
    </details>
  </section>

  <% if (recurrences.length || reviews.length) { %>
    <section class="block">
      <h2>历史</h2>
      <ul class="history">
        <% recurrences.forEach(function (r) { %>
          <li><span class="chip recur">复发</span> <%= String(r.occurred_at).slice(0, 10) %><% if (r.note) { %> · <%= r.note %><% } %></li>
        <% }) %>
        <% reviews.forEach(function (r) { %>
          <li>
            <span class="chip">复盘</span>
            <%= String(r.reviewed_at).slice(0, 10) %>
            · <%= r.result === 'good' ? '记得住' : r.result === 'fuzzy' ? '有点模糊' : '忘了' %>
          </li>
        <% }) %>
      </ul>
    </section>
  <% } %>
</article>

<%- include('partials/foot') %>
